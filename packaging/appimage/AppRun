#!/bin/sh
# AppImage entry point: run PrintLayout with the bundled Python and Qt.
HERE="$(dirname "$(readlink -f "$0")")"

# Plugin paths from the host could load system Qt plugins into the bundled Qt.
unset QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH

# -I: ignore the host's PYTHON* variables and user site-packages.
exec "$HERE/usr/python/bin/python3" -I -m printlayout "$@"
